POSTGRES_DB=apiwatch
POSTGRES_USER=apiwatch
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Always deploy an immutable commit tag. The CI pipeline publishes sha-<short-sha>.
APIWATCH_BACKEND_IMAGE=ghcr.io/hrtahsin/apiwatch-backend:sha-replace-me
APIWATCH_FRONTEND_IMAGE=ghcr.io/hrtahsin/apiwatch-frontend:sha-replace-me
APIWATCH_BIND_ADDRESS=127.0.0.1

SPRING_PROFILES_ACTIVE=production
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/apiwatch
SPRING_DATASOURCE_USERNAME=apiwatch
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-database-password
APIWATCH_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output
APIWATCH_ADMIN_USERNAME=admin
APIWATCH_ADMIN_PASSWORD=replace-with-a-distinct-long-random-password
APIWATCH_VIEWER_USERNAME=viewer
APIWATCH_VIEWER_PASSWORD=replace-with-another-distinct-long-random-password
APIWATCH_FRONTEND_ORIGIN=https://apiwatch.example.com

APIWATCH_SCHEDULER_ENABLED=true
APIWATCH_SCHEDULER_INTERVAL_MS=5000
APIWATCH_SCHEDULER_INITIAL_DELAY_MS=15000
APIWATCH_SCHEDULER_WORKER_POOL_SIZE=4
APIWATCH_SCHEDULER_QUEUE_CAPACITY=100
APIWATCH_SCHEDULER_LEASE_SECONDS=120
APIWATCH_SCHEDULER_INSTANCE_ID=
APIWATCH_NOTIFICATIONS_CLAIM_SECONDS=30
APIWATCH_NOTIFICATIONS_INSTANCE_ID=
APIWATCH_RETENTION_ENABLED=true
APIWATCH_RETENTION_HEALTH_CHECK_DAYS=90
APIWATCH_RETENTION_INCIDENT_DAYS=365
APIWATCH_RETENTION_NOTIFICATION_DAYS=90
APIWATCH_RETENTION_CRON=0 30 2 * * *

APIWATCH_BLOCK_PRIVATE_TARGETS=true
APIWATCH_PRIVATE_TARGET_ALLOWLIST=
APIWATCH_ALLOW_LOCALHOST_CORS=false
APIWATCH_PROMETHEUS_ENABLED=true
APIWATCH_DEMO_DATA_ENABLED=false
APIWATCH_DEMO_BASE_URL=http://backend:8080
VITE_API_BASE_URL=/api
VITE_DEMO_MODE=false
